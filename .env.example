# Vapi public (browser-safe) key. Get one at https://dashboard.vapi.ai -> API Keys.
# This is the PUBLIC key and is safe to ship in a frontend build.
# The app also accepts the key pasted into the input field on the page; that takes
# precedence over this env var so you can demo without a rebuild.
VITE_VAPI_PUBLIC_KEY=

# OPTIONAL: a real phone number people can dial to reach the agent.
# Set this after running `npm run provision:phone` (or buying a number in the
# dashboard). When set, a "Call from your phone" button appears on the page.
# Use E.164 format, e.g. +14155550123
VITE_VAPI_PHONE_NUMBER=
