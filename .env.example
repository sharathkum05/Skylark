# Skylark — copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Vapi (required for inbound voice agent) ---
# dashboard.vapi.ai → API Keys (PRIVATE key)
VAPI_PRIVATE_KEY=

# Inbound assistant ID (from Vapi dashboard or `npm run provision:demo`)
VAPI_INBOUND_ASSISTANT_ID=

# Shown on the landing page "Call to try live" CTA
NEXT_PUBLIC_SKYLARK_DEMO_NUMBER=+1 (803) 879-1349

# Public https URL so Vapi can reach your tool routes during calls.
# Dev: `ngrok http 3000` → paste https URL here (no trailing slash)
# Prod: your deploy URL, e.g. https://your-app.vercel.app
PUBLIC_URL=

# Tool-call authentication (recommended for any public deployment).
# 1. Vapi dashboard → Integrations → Server Configuration → Add Custom Credential:
#    Bearer Token, header "Authorization", Bearer prefix ON, token = VAPI_SERVER_SECRET.
# 2. Put that credential's ID here and run `npm run update:inbound`.
# 3. Set VAPI_SERVER_SECRET on the deployment; the tool endpoint then rejects anything else.
VAPI_SERVER_CREDENTIAL_ID=
VAPI_SERVER_SECRET=

# Outbound calls only (optional)
VAPI_PHONE_NUMBER_ID=

# --- Database (recommended) ---
# Postgres connection string. Supabase: Project Settings → Database → Connection pooling
# (transaction mode, port 6543). Unset = local JSON files in data/ (resets on Vercel).
DATABASE_URL=

# --- Admin dashboard login ---
# Required on Vercel: without ADMIN_PASSWORD the deployed dashboard stays locked.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: separate signing secret, so changing it signs everyone out.
ADMIN_SESSION_SECRET=

# --- Google Calendar (optional) ---
# One-time OAuth: visit http://localhost:3000/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Twilio SMS (optional) ---
# US numbers require carrier registration (10DLC or toll-free verification).
# Demo mode queues confirmations to /dashboard without real SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Demo / business config (optional) ---
BUSINESS_TIMEZONE=America/Chicago
# Set to false to disable demo SMS fallback panel
# DEMO_SMS_FALLBACK=true
