# Skylark — copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Vapi (required for inbound voice agent) ---
# dashboard.vapi.ai → API Keys (PRIVATE key)
VAPI_PRIVATE_KEY=

# Inbound assistant ID (from Vapi dashboard or `npm run provision:demo`)
VAPI_INBOUND_ASSISTANT_ID=

# Shown on the landing page "Call to try live" CTA
NEXT_PUBLIC_SKYLARK_DEMO_NUMBER=+1 (803) 879-1349

# Public https URL so Vapi can reach your tool routes during calls.
# Dev: `ngrok http 3000` → paste https URL here (no trailing slash)
# Prod: your deploy URL, e.g. https://your-app.vercel.app
PUBLIC_URL=

# Outbound calls only (optional)
VAPI_PHONE_NUMBER_ID=

# --- Google Calendar (optional) ---
# One-time OAuth: visit http://localhost:3000/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Twilio SMS (optional) ---
# US numbers require carrier registration (10DLC or toll-free verification).
# Demo mode queues confirmations to /dashboard without real SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Demo / business config (optional) ---
BUSINESS_TIMEZONE=America/New_York
# Set to false to disable demo SMS fallback panel
# DEMO_SMS_FALLBACK=true
