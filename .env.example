# Skylark — AI phone assistant. Copy to `.env.local` and fill in.
# .env.local is git-ignored. These are SERVER-SIDE secrets (no NEXT_PUBLIC_).

# Vapi PRIVATE key — required to place outbound calls. dashboard.vapi.ai -> API Keys.
VAPI_PRIVATE_KEY=

# The Vapi phone number Skylark calls FROM. Run `npm run provision:phone` to mint
# one for free and it prints this id. (This is the number ID, not the +1... string.)
VAPI_PHONE_NUMBER_ID=

# Public https URL pointing at THIS app, so Vapi can reach /api/vapi-webhook.
# In dev: run `ngrok http 3000` and paste the https URL here (no trailing slash).
# In prod: your deploy URL, e.g. https://skylark.vercel.app
PUBLIC_URL=

# Which Claude model the agent uses is set in lib/relay/assistant.ts (MODEL_CONFIG).
# Note: the LLM/voice/transcriber API keys live in your Vapi dashboard, not here.
